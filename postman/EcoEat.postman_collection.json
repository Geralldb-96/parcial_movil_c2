{
  "info": {
    "_postman_id": "52c59b2a-ea46-4c78-bec2-ecoeat2026",
    "name": "EcoEat API",
    "description": "Pruebas de los métodos GET, POST, PUT y DELETE del examen.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [{"key": "baseUrl", "value": "http://localhost:5000"}],
  "item": [
    {
      "name": "GET Ingredientes sugeridos",
      "request": {"method": "GET", "url": "{{baseUrl}}/api/ingredientes/sugeridos"},
      "event": [{"listen": "test", "script": {"exec": ["pm.test('Status 200', () => pm.response.to.have.status(200));", "pm.expect(pm.response.json().ingredientes).to.be.an('array');"]}}]
    },
    {
      "name": "POST Generar receta",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {"mode": "raw", "raw": "{\n  \"ingredientes\": [\"arroz\", \"tomate\", \"huevo\"]\n}"},
        "url": "{{baseUrl}}/api/receta/generar"
      },
      "event": [{"listen": "test", "script": {"exec": ["pm.test('Status 201', () => pm.response.to.have.status(201));", "const data = pm.response.json();", "pm.expect(data.receta).to.have.property('titulo');", "pm.collectionVariables.set('recipeId', data.receta.id);"]}}]
    },
    {
      "name": "PUT Marcar favorita",
      "request": {
        "method": "PUT",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {"mode": "raw", "raw": "{\n  \"id\": {{recipeId}},\n  \"favorito\": true\n}"},
        "url": "{{baseUrl}}/api/historial/favorito"
      },
      "event": [{"listen": "test", "script": {"exec": ["pm.test('Status 200', () => pm.response.to.have.status(200));", "pm.expect(pm.response.json().receta.favorito).to.eql(true);"]}}]
    },
    {
      "name": "GET Historial",
      "request": {"method": "GET", "url": "{{baseUrl}}/api/historial"},
      "event": [{"listen": "test", "script": {"exec": ["pm.test('Status 200', () => pm.response.to.have.status(200));"]}}]
    },
    {
      "name": "DELETE Eliminar receta",
      "request": {"method": "DELETE", "url": "{{baseUrl}}/api/historial/{{recipeId}}"},
      "event": [{"listen": "test", "script": {"exec": ["pm.test('Status 200', () => pm.response.to.have.status(200));", "pm.expect(pm.response.json().mensaje).to.include('eliminada');"]}}]
    }
  ]
}

